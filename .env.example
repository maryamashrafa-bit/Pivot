# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Anthropic API key — server-side only, never exposed to the browser.
# Create one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Optional: force the site URL used in email confirmation links (e.g. the
# link in a "confirm your account" email). If unset, it's inferred from the
# incoming request's host header, which works fine for a single deployment.
# Set this if you deploy the same build to multiple domains/aliases.
# NEXT_PUBLIC_SITE_URL=https://pivot-khaki.vercel.app

# Contact address shown on the Privacy Policy and site footer for data
# questions. Defaults to pivotdecisions@gmail.com if unset — override here
# if you'd rather use a different inbox.
# NEXT_PUBLIC_CONTACT_EMAIL=pivotdecisions@gmail.com
